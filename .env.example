# Copy to .env, then replace every REPLACE_* value. The API rejects these placeholders.
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD_AT_LEAST_16_CHARS

# Generate each independently, for example: openssl rand -base64 48
JWT_SIGNING_KEY=REPLACE_WITH_BASE64_RANDOM_BYTES_AT_LEAST_32_BYTES
STUDENT_CODE_PEPPER=REPLACE_WITH_A_DIFFERENT_BASE64_RANDOM_VALUE
JWT_ISSUER=testing-hosting-platform
JWT_AUDIENCE=testing-hosting-students
JWT_LIFETIME_MINUTES=10

CORS_ALLOWED_ORIGIN=http://localhost:5500
STUDENT_SESSION_RATE_LIMIT=5
STUDENT_SESSION_RATE_WINDOW_SECONDS=60
API_PORT=8080

PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_RANDOM_PGADMIN_PASSWORD
PGADMIN_PORT=5050
