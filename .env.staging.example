# Example only. Copy to .env.staging OUTSIDE Git and chmod 600.
# All REPLACE_* values must be replaced before any actual staging start.
POSTGRES_DB=platform_staging
POSTGRES_USER=platform_staging
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_48_CHAR_HEX_DATABASE_PASSWORD

# Generate independently: openssl rand -base64 48
JWT_SIGNING_KEY=REPLACE_WITH_INDEPENDENT_BASE64_JWT_SECRET
STUDENT_CODE_PEPPER=REPLACE_WITH_DIFFERENT_BASE64_STUDENT_SECRET
JWT_ISSUER=tas-staging
JWT_AUDIENCE=tas-staging-students
JWT_LIFETIME_MINUTES=10
STUDENT_SESSION_RATE_LIMIT=5
STUDENT_SESSION_RATE_WINDOW_SECONDS=60

# Set a real DNS name pointing to the staging host. Do not use a production domain.
STAGING_DOMAIN=staging.example.invalid
# GitHub Pages origin is distinct from the API domain; no path or trailing slash.
CORS_ALLOWED_ORIGIN=https://arthur200014.github.io
API_PORT=18080

# Base compose config requires these even though tools profile is NOT deployed.
PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_ADMIN_PASSWORD
PGADMIN_PORT=15050
